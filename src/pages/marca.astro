---
import Base from '../layouts/Base.astro';
import { campaignImage } from '../lib/images';
import { waLink, formatPhone } from '../lib/site';
import { getSiteContent } from '../lib/content';
import { cdnImage } from '../lib/cdn';

const site = await getSiteContent();
// Imagen subida desde el admin (Contenido → Imagen del manifiesto) o el
// asset local por defecto, igual que el hero del home.
const atelier = site.marcaImageUrl ? null : campaignImage('marca');
const WHATSAPP_NUMBER = site.whatsappNumber;
const phone = formatPhone(WHATSAPP_NUMBER);
---

<Base
  title={`${site.marcaSeoTitle} — ENIGMA®`}
  description={site.marcaSeoDescription}
  headerTheme="dark"
>
  <!-- Manifiesto de marca (oscuro). Todo el texto viene del admin →
       Contenido del sitio → «Página La marca». -->
  <section class="bg-ink pt-36 pb-section text-bone md:pt-48">
    <div class="wrap">
      {site.marcaEyebrow && <p class="caps mb-8 text-stone" data-reveal>{site.marcaEyebrow}</p>}
      <h1 class="max-w-5xl font-display text-manifesto tracking-display" data-lines>
        {
          site.marcaTitleLines.map((line) => (
            <span data-line>
              <span class="line-in">{line}</span>
            </span>
          ))
        }
      </h1>

      <div class="mt-20 grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-20">
        {
          atelier ? (
            /* Marcador local: marco fijo con parallax. Es una pieza decorativa
               de proporción conocida, así que recortarla no pierde nada.
               `<img>` directo y no <Image>: el componente pasa por /_image,
               que en producción responde 404 (ver Editorial.astro). */
            <div class="parallax-frame aspect-[8/5]">
              <img
                src={atelier.src}
                width={atelier.width}
                height={atelier.height}
                alt="El atelier de ENIGMA en penumbra"
                data-parallax
                loading="lazy"
              />
            </div>
          ) : (
            /* Foto propia subida desde el admin: manda su proporción real. El
               marco 8/5 con recorte se comía una vertical (3290×4112 quedaba
               cortada por arriba y abajo), así que aquí el <img> define su
               propio alto y se ve completa, sea vertical, cuadrada o
               horizontal. Se cambia el parallax por un fade: el parallax
               necesita recortar dentro de un marco de alto fijo, que es
               justamente lo que causaba el problema. */
            <div data-reveal>
              <img
                src={cdnImage(site.marcaImageUrl, 1800)}
                alt="El atelier de ENIGMA"
                class="w-full"
                loading="lazy"
              />
            </div>
          )
        }
        <div class="max-w-md space-y-6 leading-relaxed text-bone/80 lg:pt-10" data-reveal>
          {site.marcaParagraphs.map((text) => <p>{text}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Contacto (claro) -->
  <section id="contacto" class="bg-bone py-section text-ink" aria-labelledby="contacto-title">
    <div class="wrap">
      <h2 id="contacto-title" class="font-display text-section tracking-display" data-reveal>
        Contacto
      </h2>

      <dl class="mt-12 border-t border-line" data-reveal>
        {
          WHATSAPP_NUMBER && (
            <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line py-6">
              <dt class="caps text-stone">WHATSAPP</dt>
              <dd>
                <a
                  href={waLink(WHATSAPP_NUMBER, 'Hola, ENIGMA.')}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="u-link caps tap"
                >
                  {phone}
                </a>
              </dd>
            </div>
          )
        }
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line py-6">
          <dt class="caps text-stone">CORREO</dt>
          <dd>
            <a href={`mailto:${site.contactEmail}`} class="u-link caps tap">{site.contactEmail}</a>
          </dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line py-6">
          <dt class="caps text-stone">INSTAGRAM</dt>
          <dd>
            <a
              href={site.contactInstagram}
              target="_blank"
              rel="noopener noreferrer"
              class="u-link caps tap"
            >
              @ENIGMA
            </a>
          </dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line py-6">
          <dt class="caps text-stone">ESTUDIO</dt>
          <dd class="caps">{site.contactCity}</dd>
        </div>
      </dl>

      {
        site.marcaContactNote && (
          <p class="mt-10 max-w-md text-stone" data-reveal>
            {site.marcaContactNote}
          </p>
        )
      }
    </div>
  </section>
</Base>
