---
import QRCode from 'qrcode';
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db';
import { getSiteContent } from '../../lib/content';
import { waLink } from '../../lib/site';

const { code } = Astro.params;
const result = await db().execute({
  sql: 'SELECT * FROM orders WHERE code = ?',
  args: [code ?? ''],
});
const order = result.rows[0];
if (!order) {
  return Astro.redirect('/404');
}

const [items, events] = await Promise.all([
  db().execute({
    sql: 'SELECT * FROM order_items WHERE order_id = ?',
    args: [Number(order.id)],
  }),
  db().execute({
    sql: 'SELECT event, created_at FROM order_events WHERE order_id = ? ORDER BY created_at',
    args: [Number(order.id)],
  }),
]);

// Fecha por evento (la última si se repite, ej. re-subida de comprobante).
const eventDates = new Map<string, string>();
for (const e of events.rows) {
  eventDates.set(String(e.event), String(e.created_at));
}
const stepDate = (event: string): string | null => {
  const iso = eventDates.get(event);
  if (!iso) return null;
  const [y, m, d] = iso.slice(0, 10).split('-');
  return `${d}/${m}/${y}`;
};
const STEP_EVENTS = ['creado', 'comprobante_subido', 'validado', 'preparando', 'enviado', 'entregado'];

const site = await getSiteContent();
const status = String(order.status);
const fulfillment = order.fulfillment ? String(order.fulfillment) : null;
const carrierText = [order.carrier, order.tracking_note].filter(Boolean).join(' — guía ');
const fmt = (n: number) => `$${n.toFixed(2)} USD`;

const rejected = status === 'rechazado';
const canceled = status === 'cancelado';
const stopped = rejected || canceled;

/**
 * Trazabilidad: 6 pasos. El índice del paso actual se deriva del estado
 * de pago (status) y del estado de envío (fulfillment).
 */
const FULFILLMENT_ORDER = ['preparando', 'enviado', 'entregado'];
let currentStep = 0; // PEDIDO RECIBIDO
if (status === 'comprobante_subido') currentStep = 1;
if (status === 'validado') currentStep = 2;
if (status === 'validado' && fulfillment) {
  currentStep = 3 + FULFILLMENT_ORDER.indexOf(fulfillment);
}

const STEPS = [
  { title: 'PEDIDO RECIBIDO', text: 'Recibimos tu pedido y reservamos tus piezas.' },
  { title: 'COMPROBANTE EN REVISIÓN', text: 'Validamos tu transferencia en horas laborables.' },
  { title: 'PAGO CONFIRMADO', text: 'Tu pago fue validado.' },
  { title: 'PREPARANDO TU PEDIDO', text: 'Estamos empacando tus piezas.' },
  { title: 'ENVIADO', text: carrierText || 'Tu pedido va en camino.' },
  { title: 'ENTREGADO', text: 'Gracias por llevar ENIGMA.' },
];

const headline = rejected
  ? 'PEDIDO RECHAZADO'
  : canceled
    ? 'PEDIDO CANCELADO'
    : STEPS[currentStep].title;
const headText = rejected
  ? 'No pudimos validar el pago. Escríbenos por WhatsApp para resolverlo.'
  : canceled
    ? 'Este pedido fue cancelado. Escríbenos por WhatsApp si quieres volver a comprar.'
    : currentStep === 0
      ? 'Haz la transferencia con los datos de abajo y sube el comprobante para confirmar tu compra.'
      : STEPS[currentStep].text;

// El formulario de subida SOLO aparece antes de subir el primer comprobante.
const showBankAndUpload = status === 'pendiente';

// QR con los datos de cuenta para no tener que copiarlos a mano.
const qrText = `${site.bankDetails}\nMonto: ${fmt(Number(order.total))}\nReferencia: ${order.code}`;
const qrDataUrl = showBankAndUpload
  ? await QRCode.toDataURL(qrText, { margin: 1, width: 220 })
  : null;
---

<Base title={`Pedido ${order.code} — ENIGMA®`} description="Estado de tu pedido." noindex>
  <section class="bg-bone pt-36 pb-section text-ink md:pt-44">
    <div class="wrap max-w-3xl">
      <p class="caps text-stone" data-reveal>PEDIDO {order.code}</p>
      <h1 class="mt-3 font-display text-section tracking-display" data-reveal>{headline}</h1>
      <p class="mt-6 max-w-xl text-stone" data-reveal>{headText}</p>

      {
        /* Trazabilidad: línea de tiempo tipo hairline */
        !stopped && (
          <ol class="mt-14 border-l border-line" data-reveal aria-label="Estado del pedido">
            {STEPS.map((step, i) => {
              const done = i < currentStep;
              const current = i === currentStep;
              return (
                <li class="relative pb-8 pl-8 last:pb-0">
                  <span
                    class={`absolute top-0.5 -left-[5px] block h-[9px] w-[9px] rounded-full border ${
                      done || current ? 'border-ink bg-ink' : 'border-line bg-bone'
                    } ${current ? 'outline outline-1 outline-offset-4 outline-ink' : ''}`}
                    aria-hidden="true"
                  />
                  <p class={`caps ${done || current ? '' : 'text-stone'}`}>
                    {step.title}
                    {current && <span class="text-stone"> — AHORA</span>}
                    {(done || current) && stepDate(STEP_EVENTS[i]) && (
                      <span class="text-stone"> · {stepDate(STEP_EVENTS[i])}</span>
                    )}
                  </p>
                  {(current || (i === 4 && carrierText && done)) && (
                    <p class="mt-1 max-w-md text-sm text-stone">{step.text}</p>
                  )}
                </li>
              );
            })}
          </ol>
        )
      }

      <!-- Resumen -->
      <div class="mt-14 border-t border-line" data-reveal>
        {
          items.rows.map((it) => (
            <div class="flex justify-between gap-4 border-b border-line py-4">
              <p class="caps">
                {it.product_name}
                {it.size ? ` — ${it.size}` : ''} ×{Number(it.quantity)}
              </p>
              <p class="caps text-stone">{fmt(Number(it.unit_price) * Number(it.quantity))}</p>
            </div>
          ))
        }
        {
          Number(order.shipping) > 0 && (
            <div class="flex justify-between gap-4 border-b border-line py-4">
              <p class="caps text-stone">ENVÍO</p>
              <p class="caps text-stone">{fmt(Number(order.shipping))}</p>
            </div>
          )
        }
        {
          Number(order.discount) > 0 && (
            <div class="flex justify-between gap-4 border-b border-line py-4">
              <p class="caps text-stone">DESCUENTO{order.coupon_code ? ` (${order.coupon_code})` : ''}</p>
              <p class="caps text-stone">−{fmt(Number(order.discount))}</p>
            </div>
          )
        }
        <div class="flex justify-between gap-4 py-4">
          <p class="caps">TOTAL</p>
          <p class="caps">{fmt(Number(order.total))}</p>
        </div>
      </div>

      {
        showBankAndUpload && (
          <>
            <div class="mt-12 flex flex-col gap-6 bg-ink p-8 text-bone sm:flex-row sm:items-center" data-reveal>
              <div class="flex-1">
                <h2 class="caps">DATOS PARA LA TRANSFERENCIA</h2>
                <p class="mt-4 text-lg leading-relaxed whitespace-pre-line">{site.bankDetails}</p>
                <p class="caps mt-6 text-stone">
                  MONTO EXACTO: {fmt(Number(order.total))} · REFERENCIA: {order.code}
                </p>
              </div>
              {
                qrDataUrl && (
                  <div class="flex shrink-0 flex-col items-center gap-2">
                    <img src={qrDataUrl} alt="QR con los datos de la cuenta" width="160" height="160" class="bg-bone p-2" />
                    <p class="caps text-center text-xs text-stone">ESCANEA PARA VER LOS DATOS</p>
                  </div>
                )
              }
            </div>

            <form id="receipt-form" class="mt-12" data-reveal>
              <input type="hidden" name="code" value={String(order.code)} />
              <h2 class="caps">SUBE TU COMPROBANTE</h2>
              <label for="receipt-file" class="caps mt-4 block text-stone">
                Foto o captura de la transferencia (máx. 8 MB)
              </label>
              <input
                id="receipt-file"
                name="file"
                type="file"
                accept="image/*"
                required
                class="mt-3 block w-full max-w-md text-sm file:mr-4 file:border file:border-ink file:bg-transparent file:px-4 file:py-2 file:text-sm"
              />
              <p data-receipt-error hidden class="caps mt-4 text-stone" role="alert" />
              <button type="submit" class="btn btn-ink mt-6">ENVIAR COMPROBANTE</button>
            </form>
          </>
        )
      }

      {
        status === 'comprobante_subido' && (
          <p class="caps mt-12 text-stone" data-reveal>
            RECIBIMOS TU COMPROBANTE — TE AVISAMOS POR WHATSAPP CUANDO ESTÉ VALIDADO.
          </p>
        )
      }

      {
        site.whatsappNumber && (
          <p class="caps mt-14 text-stone" data-reveal>
            ¿DUDAS? —{' '}
            <a
              href={waLink(site.whatsappNumber, `Hola, ENIGMA. Mi pedido es ${order.code}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="u-link"
            >
              ESCRÍBENOS POR WHATSAPP
            </a>
          </p>
        )
      }

      <p class="caps mt-4 text-stone" data-reveal>
        GUARDA ESTE ENLACE PARA SEGUIR TU PEDIDO.
      </p>
    </div>
  </section>
</Base>
