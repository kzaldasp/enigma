---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db';
import { getSiteContent } from '../../lib/content';
import { waLink } from '../../lib/site';

const { code } = Astro.params;
const result = await db().execute({
  sql: 'SELECT * FROM orders WHERE code = ?',
  args: [code ?? ''],
});
const order = result.rows[0];
if (!order) {
  return Astro.redirect('/404');
}

const items = await db().execute({
  sql: 'SELECT * FROM order_items WHERE order_id = ?',
  args: [Number(order.id)],
});

const site = await getSiteContent();
const status = String(order.status);
const fmt = (n: number) => `$${n.toFixed(2)} USD`;

const STATUS_COPY: Record<string, { title: string; text: string }> = {
  pendiente: {
    title: 'PEDIDO RECIBIDO',
    text: 'Haz la transferencia con los datos de abajo y sube el comprobante para confirmar tu compra.',
  },
  comprobante_subido: {
    title: 'COMPROBANTE EN REVISIÓN',
    text: 'Recibimos tu comprobante. Lo validamos en horas laborables y te contactamos por WhatsApp.',
  },
  validado: {
    title: 'PAGO CONFIRMADO',
    text: 'Tu pago fue validado. Preparamos tu pedido y te contactamos para coordinar la entrega.',
  },
  rechazado: {
    title: 'PEDIDO RECHAZADO',
    text: 'No pudimos validar el pago. Escríbenos por WhatsApp para resolverlo.',
  },
};
const copy = STATUS_COPY[status] ?? STATUS_COPY.pendiente;
const canUpload = status === 'pendiente' || status === 'comprobante_subido';
---

<Base title={`Pedido ${order.code} — ENIGMA®`} description="Estado de tu pedido." noindex>
  <section class="bg-bone pt-36 pb-section text-ink md:pt-44">
    <div class="wrap max-w-3xl">
      <p class="caps text-stone" data-reveal>PEDIDO {order.code}</p>
      <h1 class="mt-3 font-display text-section tracking-display" data-reveal>{copy.title}</h1>
      <p class="mt-6 max-w-xl text-stone" data-reveal>{copy.text}</p>

      <!-- Resumen -->
      <div class="mt-12 border-t border-line" data-reveal>
        {
          items.rows.map((it) => (
            <div class="flex justify-between gap-4 border-b border-line py-4">
              <p class="caps">
                {it.product_name}
                {it.size ? ` — ${it.size}` : ''} ×{Number(it.quantity)}
              </p>
              <p class="caps text-stone">{fmt(Number(it.unit_price) * Number(it.quantity))}</p>
            </div>
          ))
        }
        <div class="flex justify-between gap-4 py-4">
          <p class="caps">TOTAL</p>
          <p class="caps">{fmt(Number(order.total))}</p>
        </div>
      </div>

      {
        canUpload && (
          <>
            <div class="mt-12 bg-ink p-8 text-bone" data-reveal>
              <h2 class="caps">DATOS PARA LA TRANSFERENCIA</h2>
              <p class="mt-4 text-lg leading-relaxed whitespace-pre-line">{site.bankDetails}</p>
              <p class="caps mt-6 text-stone">
                MONTO EXACTO: {fmt(Number(order.total))} · REFERENCIA: {order.code}
              </p>
            </div>

            <form id="receipt-form" class="mt-12" data-reveal>
              <input type="hidden" name="code" value={String(order.code)} />
              <h2 class="caps">
                {status === 'comprobante_subido'
                  ? 'SUBIR OTRO COMPROBANTE'
                  : 'SUBE TU COMPROBANTE'}
              </h2>
              <label for="receipt-file" class="caps mt-4 block text-stone">
                Foto o captura de la transferencia (máx. 8 MB)
              </label>
              <input
                id="receipt-file"
                name="file"
                type="file"
                accept="image/*"
                required
                class="mt-3 block w-full max-w-md text-sm file:mr-4 file:border file:border-ink file:bg-transparent file:px-4 file:py-2 file:text-sm"
              />
              <p data-receipt-error hidden class="caps mt-4 text-stone" role="alert" />
              <button type="submit" class="btn btn-ink mt-6">ENVIAR COMPROBANTE</button>
            </form>
          </>
        )
      }

      {
        site.whatsappNumber && (
          <p class="caps mt-14 text-stone" data-reveal>
            ¿DUDAS? —{' '}
            <a
              href={waLink(site.whatsappNumber, `Hola, ENIGMA. Mi pedido es ${order.code}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="u-link"
            >
              ESCRÍBENOS POR WHATSAPP
            </a>
          </p>
        )
      }

      <p class="caps mt-4 text-stone" data-reveal>
        GUARDA ESTE ENLACE PARA VER EL ESTADO DE TU PEDIDO.
      </p>
    </div>
  </section>
</Base>
