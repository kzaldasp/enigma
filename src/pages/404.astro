---
import Base from '../layouts/Base.astro';
import { resolvePageSeo } from '../lib/seo';

// Sin JSON-LD y siempre noindex: una página de error no se indexa aunque el
// admin escriba algo en seo_pages.
const seo = await resolvePageSeo('/404', {
  title: 'Página no encontrada',
  description: 'La página que buscas no existe.',
  heading: 'Esta página guarda silencio.',
});
---

<Base title={seo.title} description={seo.description} noindex>
  <section class="flex min-h-[70svh] items-center bg-bone pt-24 text-ink">
    <div class="wrap">
      <p class="caps text-stone">ERROR 404</p>
      <h1 class="mt-6 font-display text-section tracking-display">{seo.heading}</h1>
      <a href="/" class="btn btn-ink mt-12">VOLVER AL INICIO</a>
    </div>
  </section>
</Base>
