---
import Base from '../layouts/Base.astro';
import { getGallery } from '../lib/gallery';
import { cdnImage, cdnSrcset, cdnVideo } from '../lib/cdn';
import { resolvePageSeo } from '../lib/seo';

const items = await getGallery();

const seo = await resolvePageSeo('/archivo', {
  title: 'Archivo de gorras y piezas ENIGMA®',
  description:
    'El museo de ENIGMA®: cada gorra y cada pieza de ropa de lujo que salió del estudio en Ibarra, en series cortas que no se repiten.',
  heading: 'Archivo',
  intro:
    'Cada modelo que sale queda registrado aquí. Las series son cortas y no se repiten: lo que ves es lo que existió.',
});

// CollectionPage + ItemList de las piezas realmente pintadas arriba. Las que
// enlazan a un producto llevan su URL; el resto solo la imagen, que es lo
// único que existe.
const jsonLd =
  items.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': new URL('/archivo', Astro.site).href,
        url: new URL('/archivo', Astro.site).href,
        name: seo.title,
        description: seo.description,
        inLanguage: 'es-EC',
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: items.length,
          itemListElement: items.map((item, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            ...(item.caption ? { name: item.caption } : {}),
            ...(item.link ? { url: new URL(item.link, Astro.site).href } : {}),
            ...(item.type === 'image' ? { image: new URL(item.url, Astro.site).href } : {}),
          })),
        },
      }
    : undefined;
---

<Base
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage || undefined}
  noindex={seo.noindex}
  breadcrumbs={[{ name: 'Archivo' }]}
  jsonLd={jsonLd}
>
  <section class="bg-bone pt-36 pb-section text-ink md:pt-44">
    <div class="wrap">
      <header class="max-w-3xl" data-reveal>
        <p class="caps text-stone">EL MUSEO DE LA MARCA</p>
        <h1 class="mt-4 font-display text-section tracking-display">{seo.heading}</h1>
        {seo.intro && <p class="mt-6 max-w-md text-stone">{seo.intro}</p>}
      </header>

      {
        items.length === 0 ? (
          <p class="caps mt-20 text-stone" data-reveal>
            EL ARCHIVO ABRE PRONTO — LAS PRIMERAS PIEZAS ESTÁN EN CAMINO.
          </p>
        ) : (
          <div
            class="mt-16 columns-1 gap-6 sm:columns-2 md:gap-8 lg:columns-3"
            data-reveal-group
          >
            {items.map((item, i) => {
              const media =
                item.type === 'video' ? (
                  <video
                    src={cdnVideo(item.url)}
                    class="w-full"
                    autoplay
                    muted
                    loop
                    playsinline
                    aria-label={item.caption ?? `Pieza ${i + 1} del archivo`}
                  />
                ) : (
                  <img
                    src={cdnImage(item.url, 900)}
                    srcset={cdnSrcset(item.url, [320, 480, 750, 900])}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    alt={item.caption ?? `Pieza ${i + 1} del archivo`}
                    class="w-full"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                );
              const plaque = (
                <div class="mt-3 flex items-baseline justify-between gap-4">
                  <p class="caps">
                    {item.link ? <span class="u-link">{item.caption ?? 'VER PIEZA'}</span> : (item.caption ?? '')}
                  </p>
                  <span class="caps text-stone">{String(i + 1).padStart(2, '0')}</span>
                </div>
              );
              return item.link ? (
                <a
                  href={item.link}
                  class="group mb-10 block break-inside-avoid md:mb-12"
                  data-reveal-item
                >
                  <div class="zoom-frame">{media}</div>
                  {plaque}
                </a>
              ) : (
                <figure class="mb-10 break-inside-avoid md:mb-12" data-reveal-item>
                  <div class="zoom-frame">{media}</div>
                  {plaque}
                </figure>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</Base>
