---
import Base from '../layouts/Base.astro';
import { getSiteContent } from '../lib/content';
import { PROVINCES } from '../lib/site';

const site = await getSiteContent();
---

<Base title="Finalizar compra — ENIGMA®" description="Completa tu pedido." noindex>
  <section class="bg-bone pt-36 pb-section text-ink md:pt-44">
    <div class="wrap max-w-5xl">
      <h1 class="font-display text-section tracking-display" data-reveal>Finalizar compra</h1>

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
        <form id="checkout-form" class="flex flex-col gap-7">
          <div>
            <label for="co-name" class="caps text-stone">Nombre completo *</label>
            <input
              id="co-name"
              name="name"
              required
              autocomplete="name"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-phone" class="caps text-stone">WhatsApp / Teléfono *</label>
            <input
              id="co-phone"
              name="phone"
              required
              type="tel"
              autocomplete="tel"
              placeholder="0991234567"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-email" class="caps text-stone">Correo *</label>
            <input
              id="co-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-cedula" class="caps text-stone">Cédula *</label>
            <input
              id="co-cedula"
              name="cedula"
              required
              inputmode="numeric"
              pattern="[0-9]{10}"
              maxlength="10"
              autocomplete="off"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-province" class="caps text-stone">Provincia *</label>
            <select
              id="co-province"
              name="province"
              required
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body focus:outline-none focus-visible:border-b-2"
            >
              <option value="" disabled selected>Selecciona tu provincia</option>
              {PROVINCES.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div>
            <label for="co-city" class="caps text-stone">Ciudad *</label>
            <input
              id="co-city"
              name="city"
              required
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-address" class="caps text-stone">Dirección exacta *</label>
            <input
              id="co-address"
              name="address"
              required
              autocomplete="street-address"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-reference" class="caps text-stone">Referencia de ubicación *</label>
            <input
              id="co-reference"
              name="addressReference"
              required
              placeholder="Ej. casa azul frente al parque"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>
          <div>
            <label for="co-notes" class="caps text-stone">Notas (opcional)</label>
            <input
              id="co-notes"
              name="notes"
              class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
            />
          </div>

          <p data-checkout-error hidden class="caps text-stone" role="alert"></p>
          <button type="submit" class="btn btn-ink mt-2">CONFIRMAR PEDIDO</button>
          <p class="caps text-stone">
            AL CONFIRMAR RECIBES LOS DATOS BANCARIOS EN PANTALLA Y UNA COPIA EN TU CORREO.
          </p>
        </form>

        <aside
          class="lg:border-l lg:border-line lg:pl-12"
          id="checkout-config"
          data-shipping-cost={site.shippingCost}
          data-free-from={site.shippingFreeFrom}
        >
          <h2 class="caps text-stone">Tu pedido</h2>
          <ul class="mt-4" data-checkout-items></ul>

          <!-- Cupón -->
          <div class="mt-8 flex items-end gap-4">
            <div class="flex-1">
              <label for="coupon-code" class="caps text-stone">Cupón (opcional)</label>
              <input
                id="coupon-code"
                data-coupon-input
                autocomplete="off"
                placeholder="ENIGMA10"
                class="mt-2 w-full border-b border-ink bg-transparent pb-2 text-body uppercase placeholder:text-stone focus:outline-none"
              />
            </div>
            <button type="button" data-coupon-apply class="u-link caps min-h-11 shrink-0">
              APLICAR
            </button>
          </div>
          <p data-coupon-msg hidden class="caps mt-2 text-stone" role="status"></p>

          <!-- Totales -->
          <div class="caps mt-8 space-y-3 border-t border-line pt-6">
            <p class="flex justify-between text-stone">
              <span>SUBTOTAL</span>
              <span data-checkout-subtotal></span>
            </p>
            <p class="flex justify-between text-stone">
              <span>ENVÍO</span>
              <span data-checkout-shipping></span>
            </p>
            <p class="flex justify-between text-stone" data-checkout-discount-row hidden>
              <span>DESCUENTO</span>
              <span data-checkout-discount></span>
            </p>
            <p class="flex justify-between text-lg">
              <span>TOTAL</span>
              <span data-checkout-total></span>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
