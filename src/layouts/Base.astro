---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/inter';
import cormorantWoff2 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../lib/site';
import { getSiteContent } from '../lib/content';
import { cdnImage, cdnSrcset } from '../lib/cdn';
import { getPageSeo, firstFilled } from '../lib/seo';
import { SITE_DESCRIPTION } from '../lib/site';
import {
  fontStack,
  googleFontsHref,
  sanitizeFontUrl,
  DEFAULT_DISPLAY,
  DEFAULT_BODY,
} from '../lib/fonts';

const site = await getSiteContent();

/**
 * Descripción de la marca para buscadores. `siteDescription` es un campo libre
 * del admin y hoy guarda un eslogan («Judas nunca muere»), que funciona en la
 * portada pero no le dice a Google qué se vende ni dónde. Por eso la identidad
 * y el respaldo de las metas usan, en este orden: la descripción de la portada
 * escrita en admin → SEO, luego el texto de marca del código, y solo al final
 * el campo libre.
 */
const homeSeo = await getPageSeo('/');
const brandDescription = firstFilled(homeSeo.description, SITE_DESCRIPTION, site.siteDescription);

// Analítica (opcional): sin el token no se inyecta nada.
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? process.env.PUBLIC_CF_ANALYTICS_TOKEN;
const metaPixel = import.meta.env.PUBLIC_META_PIXEL_ID ?? process.env.PUBLIC_META_PIXEL_ID;

// Tipografías configurables: se sobreescriben los tokens --font-* del @theme
// con un style inline en <html> (gana a la hoja de estilos por especificidad).
const fontsHref = googleFontsHref([site.fontDisplay, site.fontBody, site.fontHero]);
// Fuentes fuera del catálogo: URL css2 pegada en el admin (solo Google Fonts).
const customFontsHref = site.fontCustomUrl ? sanitizeFontUrl(site.fontCustomUrl) : null;
const rootVars: string[] = [];
if (site.fontDisplay && site.fontDisplay !== DEFAULT_DISPLAY) {
  rootVars.push(`--font-display: ${fontStack(site.fontDisplay, 'display')}`);
}
if (site.fontBody && site.fontBody !== DEFAULT_BODY) {
  rootVars.push(`--font-sans: ${fontStack(site.fontBody, 'body')}`);
}
const htmlStyle = rootVars.length ? rootVars.join('; ') : undefined;
const heroCss = site.fontHero
  ? `[data-hero] h1 { font-family: ${fontStack(site.fontHero, 'display')}; }`
  : null;

interface Props {
  title: string;
  description?: string;
  /** Tema del header en el tope de la página (hero oscuro → 'dark'). */
  headerTheme?: 'light' | 'dark';
  ogImage?: string;
  /** true en páginas que no deben indexarse (404, etc.). */
  noindex?: boolean;
  /**
   * Canonical explícita. Solo hace falta cuando la URL visitada no es la
   * versión que debe indexarse: /catalogo?categoria=gorras apunta a
   * /catalogo/gorras para no competir consigo misma por el mismo contenido.
   */
  canonicalPath?: string;
  /** og:type — 'product' en la ficha de producto, 'article' en editoriales. */
  ogType?: string;
  /**
   * Miga de pan para buscadores: la página pasa los tramos y aquí se emite el
   * BreadcrumbList. El primer nivel (Inicio) se añade solo.
   */
  breadcrumbs?: { name: string; path?: string }[];
  /** JSON-LD propio de la página (Product, CollectionPage, FAQPage…). */
  jsonLd?: unknown;
}

const {
  title,
  description = brandDescription,
  headerTheme = 'light',
  ogImage = site.seoDefaultOgImage || '/og.jpg',
  noindex = false,
  canonicalPath,
  ogType = 'website',
  breadcrumbs = [],
  jsonLd,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// Miga de pan: Inicio + los tramos de la página. El último no lleva `item`
// porque es la página actual (así lo pide la referencia de Google).
const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Inicio', path: '/' }, ...breadcrumbs].map((b, i, all) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          ...(b.path && i < all.length - 1 ? { item: new URL(b.path, Astro.site).href } : {}),
        })),
      }
    : null;

const pageLd = [breadcrumbLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(
  Boolean,
);

// Identidad de marca para buscadores: Organization + WebSite, en todas las
// páginas. La ciudad declarada es la real (Ibarra) y la cobertura es nacional
// vía `areaServed`: eso es lo que permite competir en todo el Ecuador sin
// afirmar una dirección que no existe. `sameAs` liga la entidad a sus perfiles.
// La ciudad editable llega como 'IBARRA — ECUADOR'; el schema quiere solo el
// nombre de la ciudad, así que se corta en el guion.
const city = site.contactCity.split('—')[0]?.trim() ?? '';
const socials = [
  site.contactInstagram,
  site.contactFacebook,
  site.contactTiktok,
].filter(Boolean);

const identityLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).href,
    name: SITE_NAME,
    alternateName: 'ENIGMA®',
    url: Astro.site?.href,
    logo: new URL('/og.jpg', Astro.site).href,
    image: new URL('/og.jpg', Astro.site).href,
    description: brandDescription,
    email: site.contactEmail,
    ...(site.whatsappNumber ? { telephone: `+${site.whatsappNumber}` } : {}),
    ...(site.orgFoundingYear ? { foundingDate: site.orgFoundingYear } : {}),
    ...(socials.length ? { sameAs: socials } : {}),
    address: {
      '@type': 'PostalAddress',
      ...(city ? { addressLocality: city } : {}),
      ...(site.contactRegion ? { addressRegion: site.contactRegion } : {}),
      addressCountry: site.contactCountry || 'EC',
    },
    areaServed: { '@type': 'Country', name: 'Ecuador' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).href,
    name: SITE_NAME,
    url: Astro.site?.href,
    inLanguage: 'es-EC',
    publisher: { '@id': new URL('/#organization', Astro.site).href },
    // Habilita el cuadro de búsqueda de sitio en los resultados de Google.
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: new URL('/catalogo?q={search_term_string}', Astro.site).href,
      },
      'query-input': 'required name=search_term_string',
    },
  },
]);
---

<!doctype html>
<html lang="es" style={htmlStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /* `max-image-preview:large` es lo que permite la foto grande en el
         resultado de búsqueda y en Descubre; sin esto Google usa miniatura. */
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <link rel="canonical" href={canonical} />

    {
      /* Verificación de propiedad del sitio; se pega desde el admin → SEO. */
      site.seoVerificationGoogle && (
        <meta name="google-site-verification" content={site.seoVerificationGoogle} />
      )
    }
    {site.seoVerificationBing && <meta name="msvalidate.01" content={site.seoVerificationBing} />}
    {
      site.seoVerificationMeta && (
        <meta name="facebook-domain-verification" content={site.seoVerificationMeta} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="es_EC" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <script is:inline type="application/ld+json" set:html={identityLd} />
    {
      /* JSON-LD de la página: miga de pan + lo que aporte cada ruta
         (Product, CollectionPage, FAQPage…). */
      pageLd.length > 0 && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(pageLd)} />
      )
    }

    <link rel="preload" href={cormorantWoff2} as="font" type="font/woff2" crossorigin />
    {
      /* El hero de la portada es el elemento LCP y vive dentro de un componente
         del <body>: sin este preload el navegador no lo descubre hasta parsear
         medio documento. Solo aplica a la imagen subida al admin (Cloudinary);
         el asset local de respaldo es un SVG ligero que no lo necesita. */
      Astro.url.pathname === '/' && site.heroImageUrl && (
        <link
          rel="preload"
          as="image"
          href={cdnImage(site.heroImageUrl, 2000)}
          imagesrcset={cdnSrcset(site.heroImageUrl)}
          imagesizes="100vw"
          fetchpriority="high"
        />
      )
    }
    {
      (fontsHref || customFontsHref) && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          {fontsHref && <link rel="stylesheet" href={fontsHref} />}
          {customFontsHref && <link rel="stylesheet" href={customFontsHref} />}
        </>
      )
    }
    {heroCss && <style set:html={heroCss} />}

    <script is:inline>
      // Antes del primer paint: marca JS disponible (gatea los estados
      // iniciales de animación) y decide si el preloader ya se vio.
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('enigma:preloader')) {
          document.documentElement.setAttribute('data-preloader', 'done');
        }
      } catch {}
    </script>

    <ClientRouter />

    {
      /* Cloudflare Web Analytics: sin cookies, no necesita aviso de consentimiento.
         Se activa poniendo PUBLIC_CF_ANALYTICS_TOKEN en el entorno. */
      cfToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfToken}"}`}
        />
      )
    }

    {
      /* Meta Pixel — solo si se configura PUBLIC_META_PIXEL_ID.
         Necesario para medir conversiones de anuncios de Instagram/Facebook. */
      metaPixel && (
        <script
          is:inline
          set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
document,'script','https://connect.facebook.net/en_US/fbevents.js');
fbq('init','${metaPixel}');fbq('track','PageView');`}
        />
      )
    }

    <slot name="head" />
  </head>
  <body class="bg-bone font-sans text-ink antialiased">
    {
      /* Respaldo del píxel para navegadores sin JavaScript (parte del
         snippet oficial de Meta). Solo cuenta la vista de página. */
      metaPixel && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            alt=""
            src={`https://www.facebook.com/tr?id=${metaPixel}&ev=PageView&noscript=1`}
          />
        </noscript>
      )
    }

    <a href="#main" class="skip-link caps">Saltar al contenido</a>
    <Header theme={headerTheme} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/app.ts"></script>
  </body>
</html>
