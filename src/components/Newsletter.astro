---
/**
 * Captura de correo minimalista: input con borde inferior y botón UNIRME.
 * Sin backend — app.ts muestra la confirmación inline. Conectar el
 * `action` al proveedor real (Mailchimp, Buttondown…) cuando exista.
 */
import { getSiteContent } from '../lib/content';

const { newsletterTitle, newsletterText } = await getSiteContent();
---

<section class="border-t border-line bg-bone py-section-sm text-ink" aria-labelledby="newsletter-title">
  <div class="wrap max-w-3xl" data-reveal>
    <h2 id="newsletter-title" class="font-display text-section tracking-display">
      {newsletterTitle}
    </h2>
    <p class="mt-5 max-w-md text-stone">
      {newsletterText}
    </p>

    <form id="newsletter-form" class="mt-10 flex items-end gap-6" novalidate={false}>
      <div class="flex-1">
        <label for="newsletter-email" class="caps text-stone">Correo electrónico</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="nombre@correo.com"
          class="mt-3 w-full border-b border-ink bg-transparent pb-3 text-body placeholder:text-stone focus:outline-none focus-visible:border-b-2"
        />
      </div>
      <button type="submit" class="u-link caps min-h-11 shrink-0">UNIRME</button>
    </form>
    <p data-newsletter-done hidden class="caps mt-10" role="status">
      GRACIAS — REVISA TU CORREO.
    </p>
  </div>
</section>
