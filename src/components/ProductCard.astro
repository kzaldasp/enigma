---
import type { Product } from '../lib/products';
import { formatPrice } from '../lib/site';
import { cdnImage, cdnSrcset, cdnVideo } from '../lib/cdn';

// La rejilla va a 2 columnas en móvil y 4 desde escritorio: con esto el
// navegador pide ~50vw o ~25vw en vez de los 800 px fijos de antes.
const CARD_SIZES = '(min-width: 1024px) 25vw, 50vw';
const CARD_WIDTHS = [320, 480, 640, 800] as const;

interface Props {
  product: Product;
  /** true para cards sobre el pliegue (hero-adjacent). */
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const { slug, title, price, media, category, soldOut } = product;
const badge = soldOut ? 'AGOTADO' : product.badge;

const front = media[0];
const alternate = media[1] ?? null;
---

<a
  href={`/producto/${slug}`}
  class="group block"
  data-reveal-item
  data-category={category}
  aria-label={`${title} — ${formatPrice(price)}`}
>
  <div class="relative aspect-[3/4] overflow-hidden">
    {
      front?.type === 'video' ? (
        <video
          src={cdnVideo(front.url)}
          class={`h-full w-full object-cover transition-opacity duration-500 ${alternate ? 'group-hover:opacity-0' : ''}`}
          autoplay
          muted
          loop
          playsinline
          aria-label={`${title}, video de la pieza`}
        />
      ) : (
        <img
          src={front ? cdnImage(front.url, 800) : undefined}
          srcset={front ? cdnSrcset(front.url, CARD_WIDTHS) : undefined}
          sizes={CARD_SIZES}
          alt={`${title}, vista de la pieza`}
          class={`h-full w-full object-cover transition-opacity duration-500 ${alternate ? 'group-hover:opacity-0' : ''}`}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding={eager ? 'sync' : 'async'}
        />
      )
    }
    {
      alternate &&
        (alternate.type === 'video' ? (
          <video
            src={cdnVideo(alternate.url)}
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
          />
        ) : (
          // Segunda vista: solo se ve al pasar el puntero, así que en móvil
          // sería peso puro. `data-hover-src` deja que app.ts la resuelva solo
          // en dispositivos con hover real.
          <img
            data-hover-src={cdnImage(alternate.url, 800)}
            data-hover-srcset={cdnSrcset(alternate.url, CARD_WIDTHS)}
            sizes={CARD_SIZES}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            loading="lazy"
          />
        ))
    }
    {
      badge && (
        <span class={`caps absolute top-3 left-3 ${badge === 'AGOTADO' ? 'text-stone' : 'text-ink'}`}>
          {badge}
        </span>
      )
    }
  </div>
  {/* En rejilla de dos columnas a 320px cada card mide ~128px: título y
      precio no caben en la misma línea, así que envuelven en vez de desbordar. */}
  <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h3 class="caps min-w-0">
      <span class="u-link">{title}</span>
    </h3>
    <p
      class={`caps whitespace-nowrap ${badge === 'AGOTADO' ? 'text-stone line-through' : 'text-stone'}`}
    >
      {formatPrice(price)}
    </p>
  </div>
</a>
