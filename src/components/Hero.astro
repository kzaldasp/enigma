---
import { campaignImage } from '../lib/images';
import { getSiteContent } from '../lib/content';
import { cdnImage, cdnSrcset } from '../lib/cdn';

const { seasonLine, heroImageUrl } = await getSiteContent();
// Imagen subida desde el admin (Contenido) o el asset local por defecto.
const hero = heroImageUrl ? null : campaignImage('hero');
---

<!-- min-h con `min()`: el suelo de 34rem evita un hero achatado, pero nunca
     supera la altura real de la pantalla — en un teléfono en paisaje (≈360px)
     un mínimo fijo de 544px dejaba el botón «COMPRAR AHORA» fuera de vista. -->
<section
  data-hero
  data-lines
  class="parallax-frame relative flex h-svh min-h-[min(34rem,100svh)] flex-col justify-end bg-ink text-bone"
>
  {
    hero ? (
      // `<img>` directo: el componente <Image> pasa por /_image, que en
      // producción responde 404 (ver Editorial.astro).
      <img
        src={hero.src}
        width={hero.width}
        height={hero.height}
        alt="Campaña ENIGMA: figura en penumbra dentro del estudio"
        data-parallax
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      // El hero es el elemento LCP de la portada: `srcset` evita bajar 2000 px
      // en un teléfono, que es lo que arruinaba la métrica con datos móviles.
      // `sizes="100vw"` porque el `object-fit: cover` lo estira a todo el ancho.
      <img
        src={cdnImage(heroImageUrl, 2000)}
        srcset={cdnSrcset(heroImageUrl)}
        sizes="100vw"
        alt="Campaña ENIGMA: gorras y prendas de la serie en curso"
        data-parallax
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    )
  }
  <!-- Overlay negro al 30 % -->
  <div class="absolute inset-0 bg-ink/30" aria-hidden="true"></div>

  <div class="wrap relative pb-10 md:pb-14">
    <h1 class="font-display text-hero tracking-display">
      <span data-line><span class="line-in">ENIGMA</span></span>
    </h1>
    <div
      class="mt-8 flex flex-col gap-7 border-t border-bone/20 pt-7 md:flex-row md:items-center md:justify-between"
    >
      <p data-hero-fade class="caps">
        {seasonLine}
      </p>
      <a href="/catalogo" class="btn btn-bone self-start md:self-auto" data-hero-fade>
        COMPRAR AHORA
      </a>
    </div>
  </div>
</section>
