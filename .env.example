# Base de datos compartida con el admin (enigma-admin).
# Local: DATABASE_URL=file:../enigma-admin/local.db
# Producción: DATABASE_URL=libsql://enigma-tuusuario.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:../enigma-admin/local.db
DATABASE_AUTH_TOKEN=

# Cloudinary para comprobantes (formato cloudinary://KEY:SECRET@CLOUD).
# Vacío en desarrollo = los comprobantes se guardan en public/uploads/.
CLOUDINARY_URL=

# ── Avisos por email al dueño (opcional, resend.com) ─────────────
# Ej: NOTIFY_EMAIL=pedidos@enigma593.com
# NOTIFY_FROM debe ser una dirección de un dominio verificado en Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# ── URL pública del sitio (enlaces de correo/WhatsApp y SEO) ─────
PUBLIC_SITE_URL=https://enigma593.com

# ── Analítica (opcional, Cloudflare Web Analytics: gratis, sin cookies) ──
# Cloudflare → Analytics & Logs → Web Analytics → "Enable with JS Snippet".
PUBLIC_CF_ANALYTICS_TOKEN=

# ── Meta Pixel (opcional): solo si se hace publicidad en Instagram/Facebook.
# Business Manager → Administrador de eventos → ID del píxel.
# Ojo: usa cookies de terceros, a diferencia del resto de la analítica.
PUBLIC_META_PIXEL_ID=
