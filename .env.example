# Base de datos compartida con el admin (enigma-admin).
# Local: DATABASE_URL=file:../enigma-admin/local.db
# Producción: DATABASE_URL=libsql://enigma-tuusuario.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:../enigma-admin/local.db
DATABASE_AUTH_TOKEN=

# Cloudinary para comprobantes (formato cloudinary://KEY:SECRET@CLOUD).
# Vacío en desarrollo = los comprobantes se guardan en public/uploads/.
CLOUDINARY_URL=

# ── Avisos por email al dueño (opcional, resend.com) ─────────────
# Ej: NOTIFY_EMAIL=pedidos@enigma593.com
# NOTIFY_FROM debe ser una dirección de un dominio verificado en Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# ── WhatsApp automático al cliente (opcional, Meta Cloud API) ────
# developers.facebook.com → app "Business" → producto WhatsApp.
# Vacío = no envía nada (el flujo del pedido no se afecta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
